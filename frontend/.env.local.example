# Base URL of the AutoProfileML FastAPI backend.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser, so never put
# secrets in this file. Copy it to .env.local to override the default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client-side upload ceiling in megabytes. Keep it equal to the backend's
# AUTOPROFILEML_MAX_UPLOAD_MB so the dropzone rejects the same files the API
# would, instead of waiting for a 413.
NEXT_PUBLIC_MAX_UPLOAD_MB=200
